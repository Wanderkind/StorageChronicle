<Window x:Class="StorageChronicle.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StorageChronicle — Phase 1F" Height="760" Width="1120"
        MinWidth="850" MinHeight="600" WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="175" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock FontSize="23" FontWeight="SemiBold" Text="StorageChronicle"/>
            <TextBlock Foreground="DimGray"
                       Text="Read-only snapshot comparison · File allocation is not the same as total volume usage."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Scan directory or volume root" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <DockPanel LastChildFill="True">
                <Button x:Name="ScanButton" DockPanel.Dock="Right" Content="Take snapshot"
                        MinWidth="125" Padding="12,7" Margin="8,0,0,0"
                        Click="ScanButton_Click"/>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel scan"
                        MinWidth="105" Padding="12,7" Margin="8,0,0,0"
                        IsEnabled="False" Click="CancelButton_Click"/>
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…"
                        MinWidth="100" Padding="12,7" Margin="8,0,0,0"
                        ToolTip="Choose a directory using File Explorer"
                        Click="BrowseButton_Click"/>
                <TextBox x:Name="RootPathInput" VerticalContentAlignment="Center"
                         FontFamily="Consolas" Padding="8,6" />
            </DockPanel>
            <TextBlock x:Name="DatabaseLocationText" FontSize="11" Foreground="DimGray"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,3,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Baseline snapshot" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="BaselineChoice" MinHeight="31"
                          DisplayMemberPath="Display"
                          SelectionChanged="BaselineChoice_SelectionChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Current snapshot" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="CurrentChoice" MinHeight="31"
                          DisplayMemberPath="Display"
                          SelectionChanged="CurrentChoice_SelectionChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,18,0,0">
                <Button x:Name="CompareButton" Content="Compare"
                        MinWidth="95" Padding="12,7"
                        Click="CompareButton_Click"/>
                <Button x:Name="CancelCompareButton" Content="Cancel comparison"
                        MinWidth="130" Padding="12,7" Margin="7,0,0,0"
                        IsEnabled="False" Click="CancelCompareButton_Click"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="4" x:Name="ComparisonHintText"
                       Foreground="DimGray" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </Grid>

        <TabControl Grid.Row="3" x:Name="ResultsTabs" Margin="0,0,0,10">
            <TabItem Header="File changes">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="ChangesGrid" Grid.Row="0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" EnableRowVirtualization="True"
                              AlternatingRowBackground="#F5F7F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Change" Binding="{Binding Kind}" Width="115"/>
                            <DataGridTextColumn Header="Allocated delta" Binding="{Binding Delta}" Width="125"/>
                            <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="120"/>
                            <DataGridTextColumn Header="After" Binding="{Binding After}" Width="120"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button x:Name="PreviousPageButton" Content="Previous"
                                Padding="12,4" IsEnabled="False"
                                Click="PreviousPageButton_Click"/>
                        <TextBlock x:Name="PageIndicatorText" Text="No comparison loaded"
                                   VerticalAlignment="Center" Margin="14,0,14,0"/>
                        <Button x:Name="NextPageButton" Content="Next"
                                Padding="12,4" IsEnabled="False"
                                Click="NextPageButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Folder growth">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock x:Name="FolderTotalsText" Text="No folder summary loaded"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,3"/>
                        <TextBlock TextWrapping="Wrap" Foreground="DimGray"
                                   Text="Cumulative allocation changes including subdirectories. Parent and child totals overlap; do not add rows. Directly contained root files appear in root totals. File moves can shift allocation between folders without consuming volume space."/>
                    </StackPanel>
                    <DataGrid x:Name="FolderGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" EnableRowVirtualization="True"
                              AlternatingRowBackground="#F5F7F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Net delta" Binding="{Binding Net}" Width="125"/>
                            <DataGridTextColumn Header="Growth" Binding="{Binding Growth}" Width="115"/>
                            <DataGridTextColumn Header="Reduction" Binding="{Binding Reduction}" Width="115"/>
                            <DataGridTextColumn Header="Changed groups" Binding="{Binding ChangedGroups}" Width="120"/>
                            <DataGridTextColumn Header="Unknown groups" Binding="{Binding UnknownGroups}" Width="125"/>
                            <DataGridTextColumn Header="Folder (including descendants)" Binding="{Binding FolderPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button x:Name="FolderSortButton" Content="Sort: growth"
                                Padding="12,4" IsEnabled="False"
                                Click="FolderSortButton_Click" Margin="0,0,12,0"/>
                        <Button x:Name="PreviousFolderPageButton" Content="Previous"
                                Padding="12,4" IsEnabled="False"
                                Click="PreviousFolderPageButton_Click"/>
                        <TextBlock x:Name="FolderPageIndicatorText" Text="No folder summary loaded"
                                   VerticalAlignment="Center" Margin="14,0,14,0"/>
                        <Button x:Name="NextFolderPageButton" Content="Next"
                                Padding="12,4" IsEnabled="False"
                                Click="NextFolderPageButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Reconciliation">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ReconciliationStatusText" Grid.Row="0"
                               Text="Compare two saved snapshots to review reconciliation evidence."
                               FontSize="15" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Foreground="DimGray"
                               TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Positive free-space loss means less free space at the end of the current scan. Positive file allocation change means measured file growth. Their difference is an unassigned accounting residual, never proof that Windows or a particular program consumed it."/>
                    <TextBox x:Name="ReconciliationDetailsText" Grid.Row="2"
                             IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             Padding="12" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </TabItem>
            <TabItem Header="Scan coverage">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Inspect saved snapshot:"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" x:Name="CoverageSnapshotChoice"
                                  MinWidth="125" MinHeight="28"
                                  DisplayMemberPath="Display"
                                  SelectionChanged="CoverageSnapshotChoice_SelectionChanged"/>
                        <TextBlock Grid.Column="2" Text="Notice filter:"
                                   VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <ComboBox Grid.Column="3" x:Name="CoverageFilterChoice"
                                  SelectedIndex="0"
                                  SelectionChanged="CoverageFilterChoice_SelectionChanged">
                            <ComboBoxItem Content="All notices"/>
                            <ComboBoxItem Content="Read errors"/>
                            <ComboBoxItem Content="Warnings"/>
                            <ComboBoxItem Content="Information"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="CoverageSummaryText" Grid.Row="1"
                               FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="Select a saved snapshot to inspect its recorded coverage."
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="CoverageCategoriesText" Grid.Row="2"
                               TextWrapping="Wrap" Foreground="DimGray"
                               Margin="0,0,0,8" MaxHeight="75"/>
                    <DataGrid x:Name="CoverageIssuesGrid" Grid.Row="3"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" EnableRowVirtualization="True"
                              AlternatingRowBackground="#F5F7F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="185"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="4" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button x:Name="PreviousCoveragePageButton"
                                Content="Previous" Padding="12,4" IsEnabled="False"
                                Click="PreviousCoveragePageButton_Click"/>
                        <TextBlock x:Name="CoveragePageIndicatorText"
                                   Text="No scan notices loaded"
                                   VerticalAlignment="Center" Margin="14,0,14,0"/>
                        <Button x:Name="NextCoveragePageButton"
                                Content="Next" Padding="12,4" IsEnabled="False"
                                Click="NextCoveragePageButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Grid.Row="0" Text="Ready."
                       FontWeight="SemiBold" Margin="0,0,0,8"
                       TextWrapping="Wrap"/>
            <TextBox x:Name="SummaryText" Grid.Row="1" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" Padding="9"
                     FontFamily="Consolas" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
